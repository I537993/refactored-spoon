<?xml version="1.0" encoding="UTF-8"?>
<Calculation:scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Calculation="http://www.sap.com/ndb/BiModelCalculation.ecore" id="mycalculationview" applyPrivilegeType="NONE" dataCategory="CUBE" schemaVersion="3.0" hierarchyGeneration="SQL" outputViewType="Aggregation" cacheInvalidationPeriod="NONE" enforceSqlExecution="true" application="BAS">
<descriptions defaultDescription="Book inventory values (price x stock)"/>
<localVariables/>
<variableMappings/>
<dataSources>
  <DataSource id="BOOKS_SRC">
    <resourceUri>BOOKS_SRC</resourceUri>
  </DataSource>
</dataSources>
<calculationViews/>
<logicalModel id="BOOKS_SRC">
  <attributes>
    <attribute id="ID" order="1" attributeHierarchyActive="false" displayAttribute="false">
      <descriptions defaultDescription="ID"/>
      <keyMapping columnObjectName="BOOKS_SRC" columnName="ID"/>
    </attribute>
    <attribute id="TITLE" order="2" attributeHierarchyActive="false" displayAttribute="false">
      <descriptions defaultDescription="Title"/>
      <keyMapping columnObjectName="BOOKS_SRC" columnName="TITLE"/>
    </attribute>
    <attribute id="AUTHOR" order="3" attributeHierarchyActive="false" displayAttribute="false">
      <descriptions defaultDescription="Author"/>
      <keyMapping columnObjectName="BOOKS_SRC" columnName="AUTHOR"/>
    </attribute>
  </attributes>
  <calculatedAttributes/>
  <baseMeasures>
    <measure id="PRICE" order="4" aggregationType="sum" measureType="simple">
      <descriptions defaultDescription="Price"/>
      <measureMapping columnObjectName="BOOKS_SRC" columnName="PRICE"/>
    </measure>
    <measure id="STOCK" order="5" aggregationType="sum" measureType="simple">
      <descriptions defaultDescription="Stock"/>
      <measureMapping columnObjectName="BOOKS_SRC" columnName="STOCK"/>
    </measure>
  </baseMeasures>
  <calculatedMeasures>
    <measure id="TOTAL_VALUE" order="6" aggregationType="sum" type="CALCULATED" datatype="DECIMAL" length="15" scale="2" measureType="amount">
      <descriptions defaultDescription="Total Value (price x stock)"/>
      <formula>&quot;PRICE&quot; * &quot;STOCK&quot;</formula>
    </measure>
  </calculatedMeasures>
  <restrictedMeasures/>
  <localDimensions/>
</logicalModel>
<layout>
  <shapes>
    <shape expanded="true" modelObjectName="Output" modelObjectNameSpace="MeasureGroup">
      <upperLeftCorner x="40" y="85"/>
    </shape>
  </shapes>
</layout>
</Calculation:scenario>
